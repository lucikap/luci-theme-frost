{#
	Frost is a clean HTML5 theme for LuCI. It is based on luci-theme-material Frost Template

	luci-theme-frost
	Copyright 2020 Jerrykuku <jerrykuku@qq.com>

	Have a bug? Please create an issue here on GitHub!
	https://github.com/jerrykuku/luci-theme-frost/issues

	luci-theme-material:
	Copyright 2015 Lutty Yang <lutty@wcan.in>

	Frost Theme
	https://demos.creative-tim.com/frost-dashboard/index.html

	Licensed to the public under the Apache License 2.0
-#}

{# Shared document head. Callers supply hostname and is_login explicitly. -#}
{%
	import { access, lsdir, lstat, stat } from 'fs';
	import { cursor } from 'uci';
	import { dark_palette, appearance_modes } from 'luci.frost-palette';

	let cfg = cursor();
	http.prepare_content('text/html; charset=UTF-8');

	//Custom settings
	function validColor(value, fallback) {
		return type(value) == 'string' && match(value, /^#[0-9a-fA-F]{3}([0-9a-fA-F]{3})?$/) ? value : fallback;
	}

	function validNumber(value, fallback, maximum) {
		return type(value) == 'string' && match(value, /^(0|[1-9][0-9]*)(\.[0-9]+)?$/) && +value <= maximum ? value : fallback;
	}

	let mode = 'normal';
	let primary = '#5e72e4';
	let dark_primary = '#483d8b';
	let blur_radius = '10';
	let blur_radius_dark = '10';
	let blur_opacity = '0.5';
	let blur_opacity_dark = '0.5';
	let glass_admin = '1';
	let auto_color = '0';
	const has_frost_config = access('/etc/config/frost');
	let dark_settings = {};
	if (has_frost_config) {
		for (let key in ['dark_primary_mode', 'dark_primary', 'dark_glass_mode', 'blur', 'blur_dark', 'transparency', 'transparency_dark'])
			dark_settings[key] = cfg.get_first('frost', 'global', key);
		primary = validColor(cfg.get_first('frost', 'global', 'primary'), primary);
		dark_primary = validColor(cfg.get_first('frost', 'global', 'dark_primary'), dark_primary);
		blur_radius = validNumber(cfg.get_first('frost', 'global', 'blur'), blur_radius, 100);
		blur_radius_dark = validNumber(cfg.get_first('frost', 'global', 'blur_dark'), blur_radius_dark, 100);
		blur_opacity = validNumber(cfg.get_first('frost', 'global', 'transparency'), blur_opacity, 1);
		blur_opacity_dark = validNumber(cfg.get_first('frost', 'global', 'transparency_dark'), blur_opacity_dark, 1);
		let configured_glass = cfg.get_first('frost', 'global', 'glass_admin');
		if (configured_glass == '0' || configured_glass == '1')
			glass_admin = configured_glass;

		let configured_color = cfg.get_first('frost', 'global', 'auto_color');
		if (configured_color == '0' || configured_color == '1')
			auto_color = configured_color;

		/* one global transparency/blur knob for the login card and the admin UI */
		let glass_alpha = validNumber(cfg.get_first('frost', 'global', 'glass_alpha'), null, 1);
		let glass_blur = validNumber(cfg.get_first('frost', 'global', 'glass_blur'), null, 100);
		if (glass_alpha != null) {
			blur_opacity = glass_alpha;
			blur_opacity_dark = glass_alpha;
		}
		if (glass_blur != null) {
			blur_radius = glass_blur;
			blur_radius_dark = glass_blur;
		}
		let configured_mode = cfg.get_first('frost', 'global', 'mode');
		if (configured_mode == 'normal' || configured_mode == 'dark' || configured_mode == 'light')
			mode = configured_mode;
	}
	const dark_modes = appearance_modes(dark_settings);
	const palette = dark_palette(dark_modes.color == 'custom' ? dark_primary : primary, dark_modes.color == 'custom');
	dark_primary = palette.primary;
	if (dark_modes.glass == 'inherit') {
		blur_radius_dark = blur_radius;
		blur_opacity_dark = blur_opacity;
	}
	const bar_color = mode == 'dark' ? dark_primary : primary;

-%}
<!DOCTYPE html>
<html lang="{{ dispatcher.lang }}" data-frost-mode="{{ mode }}" data-frost-glass="{{ glass_admin }}" data-frost-auto-color="{{ auto_color }}">

<head>
	{% if (!is_login): %}
	{%
		const icon_dir = '/www/luci-static/frost/icon/';
		const menu_icons = filter(lsdir(icon_dir) ?? [], name =>
			match(name, /^[a-zA-Z0-9_-]+\.svg$/) && lstat(icon_dir + name)?.type == 'file');
	%}
	<meta name="frost-menu-icons" content="{{ entityencode(join(' ', menu_icons), true) }}">
	{% endif %}
	{% include("themes/" + theme + "/head_meta", { hostname: hostname, node: node, bar_color: bar_color, media: media, mode: mode, primary: primary, dark_primary: dark_primary }) %}

	{%
		// Source builds can change CSS without changing the package version.
		// ctime also catches replacements which preserve mtime and file size.
		/* fingerprint every theme asset so a JS-only change also busts the
		 * cached ?v= of the CSS and of the L.require()ed theme classes */
		const asset_paths = [
			'/www' + media + '/css/cascade.css',
			'/www' + media + '/js/autocolor.js',
			'/www/luci-static/resources/frost-ui.js',
			'/www/luci-static/resources/menu-frost.js',
			'/www/luci-static/resources/frost-appearance.js',
			'/www/luci-static/resources/frost-compat.js',
			'/www/luci-static/resources/frost-overview.js',
			'/www/luci-static/resources/frost-graphs.js',
			'/www/luci-static/resources/frost-sshkeys.js',
			'/www/luci-static/resources/view/frost-config.js'
		];
		let asset_mtime = 0, asset_ctime = 0, asset_size = 0;
		for (let i = 0; i < length(asset_paths); i++) {
			const st = stat(asset_paths[i]);
			if (st) {
				asset_mtime = max(asset_mtime, st.mtime ?? 0);
				asset_ctime = max(asset_ctime, st.ctime ?? 0);
				asset_size += st.size;
			}
		}
		/* squashfs usually reports mtime 0, ctime and size are reliable */
		const stylesheet_version = asset_size
			? sprintf('%d-%d-%d', asset_size, asset_ctime, asset_mtime)
			: '0';
	%}
	<link rel="preload" href="{{ media }}/fonts/GoogleSans-Regular.woff2" as="font" type="font/woff2" crossorigin>
	<link rel="preload" href="{{ media }}/fonts/TypoGraphica.woff2" as="font" type="font/woff2" crossorigin>
	<link rel="stylesheet" href="{{ media }}/css/cascade.css?v={{ stylesheet_version }}">
	<script>window.__FROST_ASSET_VERSION = '{{ stylesheet_version }}';</script>
	<script defer src="{{ media }}/js/boot.js?v={{ stylesheet_version }}"></script>
	<script defer src="{{ media }}/js/autocolor.js?v={{ stylesheet_version }}"></script>
	<style title="text/css">
		:root {
			--light-primary: {{ primary }};
			--dark-primary: {{ dark_primary }};
			--dark-on-primary: {{ palette.on_primary }};
			--dark-link-color: {{ palette.link }};
			--dark-focus-ring: {{ palette.focus }};
			--dark-control-focus: {{ palette.control_focus }};
			--dark-progress-fill: {{ palette.progress }};
			--dark-control-ring: {{ palette.control_ring }};
			--dark-selected-bg: {{ palette.selected }};
			--dark-selected-hover-bg: {{ palette.hover }};
			--dark-accent-ring: {{ palette.ring }};
			--dark-accent-shadow: {{ palette.shadow }};
			--dark-checkmark-icon: url("data:image/svg+xml,%3csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 8 8'%3e%3cpath fill='%23{{ substr(palette.on_primary, 1) }}' d='M6.564.75l-3.59 3.612-1.538-1.55L0 4.26 2.974 7.25 8 2.193z'/%3e%3c/svg%3e");
			--blur-radius-light:{{ blur_radius }}px;
			--blur-opacity-light:{{ blur_opacity }};
			--frost-glass-alpha: {{ blur_opacity }};
			--frost-glass-blur: {{ blur_radius }}px;
			--blur-radius-dark:{{ blur_radius_dark }}px;
			--blur-opacity-dark:{{ blur_opacity_dark }};
		}
	</style>
	<!-- Stylesheets -->
	{% if (node?.css): %}
	<link rel="stylesheet" href="{{ resource }}/{{ node.css}}">
	{% endif -%}
	{% if (css): %}
	<style title="text/css">
		{{ css }}
	</style>
	{% endif -%}
	{% if (!is_login): %}
	<script src="{{ dispatcher.build_url('admin/translations', dispatcher.lang) }}?v={{ version.luciversion }}"></script>
	<script src="{{ resource }}/cbi.js?v={{ version.luciversion }}"></script>
	{% endif %}
</head>
